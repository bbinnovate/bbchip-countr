rules_version = '2';

// ===============================================================
// Data model (kept intentionally light — see below for why)
// ===============================================================
//
// Collection: sessions
// Document ID: Firestore auto-ID, doubles as the app's shareable
//   "table link". Anyone signed in (even anonymously) who has the
//   ID can view/tap buy-ins/settle it — no login, no invite list,
//   the unguessable ID is the access control (same trust model as
//   a shareable Google Docs link).
// Fields: hostUid, bankValue, currency, players (list), status
//   ("active" | "settled"), startedAt, endedAt, date.
//
// Collection: playerHistories/{code}/sessions/{sessionId}
// A denormalized, immutable copy of a settled session, keyed by a
// user-chosen portable "Player Code" instead of the device-bound
// anonymous uid, so history follows the person, not the device.
//
// This ruleset deliberately validates only the invariants that
// actually matter (auth required, settled records are immutable) and
// skips strict per-field/per-player schema checks — those turned out
// to be too brittle in practice (rejecting legitimate writes for
// reasons that were hard to pin down) for an app with no real
// adversarial user model in the first place.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    match /sessions/{sessionId} {
      allow get: if isAuthenticated();

      // History/dashboard queries always filter hostUid == caller's
      // own uid, so only the owner's sessions are ever listed.
      allow list: if isAuthenticated() && resource.data.hostUid == request.auth.uid;

      allow create: if isAuthenticated() &&
        request.resource.data.hostUid == request.auth.uid &&
        request.resource.data.status == 'active' &&
        request.resource.data.players is list;

      // Anyone holding the table link may tap buy-ins while it's live
      // and close it out once. A settled session can never be written
      // to again (its history copy is the permanent record).
      allow update: if isAuthenticated() &&
        resource.data.status != 'settled' &&
        request.resource.data.players is list;

      // Only the host can discard a table, and only before it's settled.
      allow delete: if isAuthenticated() &&
        resource.data.hostUid == request.auth.uid &&
        resource.data.status == 'active';
    }

    match /playerHistories/{code} {
      // No `list` here — codes can only be looked up one at a time by
      // someone who already has the exact code, never enumerated.
      allow get: if isAuthenticated();
      allow write: if isAuthenticated();

      match /sessions/{sessionId} {
        allow get, list: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.players is list;
        // Settled history is a permanent, immutable record.
        allow update, delete: if false;
      }
    }

    // Default deny for everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
